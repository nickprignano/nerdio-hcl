tenant_id       = "00000000-0000-0000-0000-000000000000"
subscription_id = "00000000-0000-0000-0000-000000000000"
prefix          = "contoso-nme"
location        = "eastus2"

tags = {
  workload    = "avd"
  managed-by  = "terraform"
  environment = "prod"
}

resource_groups = {
  nerdio     = "rg-contoso-nerdio"
  network    = "rg-contoso-avd-network"
  hostpools  = "rg-contoso-avd-hostpools"
  storage    = "rg-contoso-avd-storage"
  monitoring = "rg-contoso-avd-monitoring"
}

network = {
  address_space = ["10.50.0.0/20"]
  subnets = {
    session_hosts     = "10.50.0.0/22"
    private_endpoints = "10.50.4.0/27"
    app_integration   = "10.50.4.32/27"
  }
  # dns_servers = ["10.0.0.4", "10.0.0.5"]   # domain controllers, for AD DS joined hosts
  # hub_vnet_id = "/subscriptions/.../resourceGroups/rg-hub/providers/Microsoft.Network/virtualNetworks/vnet-hub"
}

fslogix = {
  storage_account_name  = "stcontosofslogix01"
  identity_source       = "AADKERB"
  user_group_object_ids = ["11111111-1111-1111-1111-111111111111"]
  # For AD DS hybrid authentication (identity_source = "AD"):
  # active_directory = {
  #   domain_name         = "corp.contoso.com"
  #   domain_guid         = "00000000-0000-0000-0000-000000000000"
  #   domain_sid          = "S-1-5-21-1000000000-2000000000-3000000000"
  #   storage_sid         = "S-1-5-21-1000000000-2000000000-3000000000-1105"
  #   netbios_domain_name = "CONTOSO"
  # }
}

image_gallery = {
  name                      = "gal_contoso_avd"
  build_resource_group_name = "rg-contoso-avd-images-build"
}

# "terraform" (default) builds Nerdio Manager in Terraform; "marketplace" supports a normal
# Azure portal Marketplace deployment (or an exported template when nerdio_template_file is set)
# and discovers the Marketplace resources in resource_groups["nerdio"].
nerdio_install = "terraform"
# nerdio_core = { package_version = "latest", app_service_plan_sku = "B3", database_sku = "S1" }
# For a normal Azure portal Marketplace deployment:
# nerdio_install   = "marketplace"
# create_entra_app = false
# existing_resource_groups = ["nerdio"]   # if you created the resource group in the portal first

entra_app = {
  wvd_admin_object_ids = ["22222222-2222-2222-2222-222222222222"]
  grant_admin_consent  = false
  # existing_client_id = "00000000-0000-0000-0000-000000000000"   # when create_entra_app = false, so Terraform still builds the stage 2 REST client
}

# Second apply, after the Marketplace deployment exists:
enable_hardening = false
