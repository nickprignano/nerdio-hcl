# scripts/pipeline/bootstrap.sh writes pipeline.auto.tfvars.json for you. This shows the shape.
tenant_id       = "00000000-0000-0000-0000-000000000000"
subscription_id = "00000000-0000-0000-0000-000000000000"
name            = "nme-sbx"
location        = "eastus2"
environment     = "sandbox"

github = {
  owner      = "contoso"
  repository = "nerdio-hcl"
  reviewers  = ["contoso-admin"]
}

# Optional. Both default to true; put overrides in terraform.tfvars next to this file.
# github_settings = {
#   protect_branch                 = true # ruleset: the branch only changes through pull requests
#   actions_can_open_pull_requests = true # kb-feedback opens its own pull request
# }

# Optional, for tenants with strict access rules: narrow what the pipeline's identities may do.
# Leave a field out to keep the kit's default. See docs/access.md before changing these.
# access = {
#   apply_graph_roles = ["Application.ReadWrite.All", "Group.ReadWrite.All", "Directory.Read.All"] # you grant admin consent yourself
# }
