# ./nerdio assistant writes tenant_id, subscription_id and admin_group for you.
tenant_id       = "00000000-0000-0000-0000-000000000000"
subscription_id = "00000000-0000-0000-0000-000000000000"
admin_group     = "AVD Admins"
location        = "eastus2"

