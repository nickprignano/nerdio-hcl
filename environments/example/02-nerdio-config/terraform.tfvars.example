# Connection details, the secret hand-off, subscription, regions (networks + FSLogix shares) and
# gallery image definition IDs come from platform.auto.tfvars.json, written by 01-platform
# (see docs/deployment-runbook.md).

workspaces = {
  "ws-avd" = {
    name          = "ws-avd"
    friendly_name = "Virtual Desktops"
    # region_key  = "eastus2"
  }
}

# ad_config_friendly_name = "Entra ID joined"   # the directory profile name from the setup wizard

host_pools = {
  "hp-general" = {
    friendly_name         = "General desktops"
    host_pool_type        = "Pooled"
    vm_prefix             = "avdgen"
    vm_size               = "Standard_D4s_v5"
    has_ephemeral_os_disk = false
    encryption_at_host    = false
    # region_key          = "eastus2"             # defaults to the first sorted region in var.regions
    # workspace_key       = "ws-avd"              # defaults to the first sorted workspace in var.workspaces
    # image               = "win11-24h2-avd-m365" # key from gallery_image_definition_ids once Packer builds it
  }
  # "hp-devs" = {
  #   friendly_name   = "Developer personal desktops"
  #   host_pool_type  = "Personal"
  #   assignment_type = "Automatic"
  #   vm_prefix       = "avddev"
  #   vm_size         = "Standard_D8s_v5"
  # }
}

# Optional multi-region FSLogix Cloud Cache across all regional profile shares:
# fslogix_options = {
#   cloud_cache = true
# }

