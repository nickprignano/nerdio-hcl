# Connection details, the secret hand-off, subscription, network, FSLogix share and gallery
# image definition IDs come from platform.auto.tfvars.json, written by 01-platform
# (see docs/deployment-runbook.md).

workspace = {
  name          = "ws-avd"
  friendly_name = "Virtual Desktops"
}

# ad_config_friendly_name = "Entra ID joined"   # the directory profile name from the setup wizard

host_pools = {
  "hp-general" = {
    friendly_name         = "General desktops"
    host_pool_type        = "Pooled"
    vm_prefix             = "avdgen"
    vm_size               = "Standard_D4s_v5"
    has_ephemeral_os_disk = false
    encryption_at_host    = false
    # image = "win11-24h2-avd-m365"             # key from gallery_image_definition_ids once Packer builds it
  }
  # "hp-devs" = {
  #   friendly_name   = "Developer personal desktops"
  #   host_pool_type  = "Personal"
  #   assignment_type = "Automatic"
  #   vm_prefix       = "avddev"
  #   vm_size         = "Standard_D8s_v5"
  # }
}

# Optional static host pools, RDP profiles, VM deployment profiles, scripted actions and REST gap fillers:
