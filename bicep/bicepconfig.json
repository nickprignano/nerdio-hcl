{
  "analyzers": {
    "core": {
      "enabled": true,
      "rules": {
        "no-unused-vars": {
          "level": "error"
        },
        "no-unused-params": {
          "level": "warning"
        },
        "no-hardcoded-env-urls": {
          "level": "warning"
        },
        "use-recent-api-versions": {
          "level": "off"
        }
      }
    }
  },
  "extensions": {
    "microsoftGraphV1": "br:mcr.microsoft.com/bicep/extensions/microsoftgraph/v1.0:1.0.0"
  }
}
